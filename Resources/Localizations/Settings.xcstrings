    "general.show_dock_icon_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the app runs only in the menu bar and is hidden from the Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，应用仅在菜单栏运行，不在程序坞中显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，應用程式僅在選單列運行，不在 Dock 中顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、アプリはメニューバーのみで動作し、Dockには表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 앱이 메뉴 막대에서만 실행되고 Dock에서 숨겨집니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، يعمل التطبيق في شريط القوائم فقط ويُخفى من Dock."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ থাকলে অ্যাপটি শুধু মেনু বারে চলে এবং Dock থেকে লুকানো থাকে।"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ανενεργό, η εφαρμογή εκτελείται μόνο στη γραμμή μενού και κρύβεται από το Dock."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی خاموش است، برنامه فقط در نوار منو اجرا می‌شود و از Dock پنهان می‌شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשכבוי, האפליקציה פועלת רק בשורת התפריטים ומוסתרת מה-Dock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, ऐप केवल मेनू बार में चलता है और Dock से छिपा रहता है।"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលបិទ កម្មវិធីដំណើរការតែក្នុងរបារម៉ឺនុយ ហើយលាក់ពី Dock។"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມື່ອປິດ ແອັບຈະເຮັດວຽກສະເພາະໃນແຖບເມນູ ແລະ ຖືກເຊື່ອງຈາກ Dock."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Унтраасан үед апп зөвхөн цэсний мөрөнд ажиллаж, Dock-оос нуугдана."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပိတ်ထားသောအခါ အက်ပ်သည် မီနူးဘားတွင်သာ လုပ်ဆောင်ပြီး Dock မှ ဖျောက်ထားသည်။"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बन्द हुँदा, एप मेनु बारमा मात्र चल्छ र Dock बाट लुकाइन्छ।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, приложение работает только в строке меню и скрыто из Dock."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අක්‍රිය විට, යෙදුම මෙනු තීරුවේ පමණක් ක්‍රියාත්මක වන අතර Dock වෙතින් සඟවා ඇත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அணைக்கப்பட்டால், பயன்பாடு மெனு பட்டியில் மட்டுமே இயங்கும், Dock இல் மறைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్ చేసినప్పుడు, యాప్ మెను బార్‌లో మాత్రమే నడుస్తుంది మరియు Dock నుండి దాచబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิด แอปจะทำงานเฉพาะในแถบเมนูและถูกซ่อนจาก Dock"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли вимкнено, застосунок працює лише в рядку меню та прихований з Dock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, ứng dụng chỉ chạy trên thanh menu và ẩn khỏi Dock."
          }
        }
      }
    }
  },
  "version": "1.0"
}
